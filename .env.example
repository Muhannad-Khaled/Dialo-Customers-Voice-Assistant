# ─── Gemini ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Groq (Whisper STT — free key at console.groq.com) ────
GROQ_API_KEY=your_groq_api_key_here

# ─── LiveKit ──────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=dialo
POSTGRES_PASSWORD=dialo_pass
POSTGRES_DB=dialo_db
DATABASE_URL=postgresql+asyncpg://dialo:dialo_pass@postgres:5432/dialo_db

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── ChromaDB ─────────────────────────────────────────────
# CHROMA_PORT is the container's INTERNAL port (compose maps host 8001 -> 8000).
# For non-Docker dev use CHROMA_HOST=localhost and CHROMA_PORT=8001.
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── STT / TTS models ─────────────────────────────────────
# Faster-Whisper size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Piper voice model + directory (auto-downloaded on backend image build)
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_DIR=/app/tts_models

# ─── Arabic TTS engine (Piper has no Egyptian voice) ──────
# "gemini" reuses GEMINI_API_KEY (no new secret, default) | "azure" for a dedicated
# ar-EG neural voice. If the Gemini preview TTS model 404s on your key, set "azure".
ARABIC_TTS_PROVIDER=gemini

# Gemini TTS (default) — reuses GEMINI_API_KEY above.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Azure Speech (fallback) — only needed when ARABIC_TTS_PROVIDER=azure.
# Free tier: 0.5M chars/mo. Create a Speech resource at portal.azure.com.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE_AR=ar-EG-SalmaNeural

# Default reply language when a call sends none ("en" | "ar").
DEFAULT_LANGUAGE=en

# ─── Voice pipeline mode (frontend) ───────────────────────
# agent = real-time LiveKit agent (default) | rest = record->STT->chat->TTS fallback
NEXT_PUBLIC_VOICE_MODE=agent

# ─── Auth ─────────────────────────────────────────────────
SECRET_KEY=changeme_use_strong_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── FastAPI ──────────────────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
